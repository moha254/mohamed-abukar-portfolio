# Server-only variables for the contact form (api/contact.ts).
# Never prefix these with VITE_ — that would expose them in the browser bundle.
#
# Local development: copy this file to .env.local (git-ignored) and fill in real values.
# Production: set the same three variables in Vercel → Project → Settings → Environment Variables.

RESEND_API_KEY=re_replace_with_your_rotated_key
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
CONTACT_TO_EMAIL=mohamedabukar412@gmail.com
